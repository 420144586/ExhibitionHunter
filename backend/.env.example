# App
APP_NAME=ExhibitionHunter API
DEBUG=true
API_V1_PREFIX=/api

# Database (SQLite file path, relative to backend/ root)
DATABASE_URL=sqlite+aiosqlite:///./data/exhibitions.db

# Crawler
# playwright or httpx (auto-selected per spider; this is the global default)
CRAWLER_DEFAULT_ENGINE=auto
# Max concurrent requests per spider run
CRAWLER_MAX_CONCURRENCY=4
# User-Agent for httpx requests
CRAWLER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36

# Scheduler (cron) - empty = disabled on boot
SCHEDULER_ENABLED=true
# e.g. "0 3 * * *" = 03:00 daily
SCHEDULER_CRAWL_CRON=0 3 * * *

# Crawler window: only keep exhibitions starting within next N months (+ ongoing)
CRAWLER_FUTURE_MONTHS=3

# Logging
LOG_LEVEL=INFO
LOG_DIR=./data/logs
